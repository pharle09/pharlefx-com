# Server-only; configure these in Vercel Project Settings, never in the browser build.
DERIV_API_TOKEN=
DERIV_ENV=demo
DERIV_WS_URL=wss://ws.deriv.com/websockets/v3
# HMAC secret used to verify pharlefx_session=<base64url(payload)>.<base64url(signature)>.
TRADING_AUTH_SECRET=
TRADING_SESSION_COOKIE=pharlefx_session
TRADING_APP_ORIGIN=https://pharlefx.com
